rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Security Primitives
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && request.auth.token.email == 'nagarilasi25@gmail.com';
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isEmailVerified() && hasUserDoc() && getUserData().status == 'active';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isActiveUser() && getUserData().role == 'Administrator');
    }

    function isPimpinan() {
      return isActiveUser() && getUserData().role == 'Pimpinan';
    }

    function isOperator() {
      return isActiveUser() && getUserData().role == 'Operator';
    }

    function isAuthorizedStaff() {
      return isAdmin() || isPimpinan() || isOperator();
    }

    function institutionExists(instId) {
      return isValidId(instId) && exists(/databases/$(database)/documents/institutions/$(instId));
    }

    function proposalExists(propId) {
      return isValidId(propId) && exists(/databases/$(database)/documents/proposals/$(propId));
    }

    // =========================================================================
    // Entity Validation Blueprints (Anti-Update-Gap)
    // =========================================================================

    function isValidInstitution(data) {
      return data.keys().hasAll(['name', 'address', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly([
          'name', 'logoUrl', 'photoUrl', 'address', 'kecamatan', 'kabupaten',
          'provinsi', 'negara', 'phone', 'email', 'foundedYear', 'statisticNumber',
          'legalityInfo', 'leaderName', 'history', 'vision', 'mission',
          'organizationStructure', 'studentCount', 'teacherCount',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.name is string && data.name.size() <= 200
        && data.address is string && data.address.size() <= 500
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 2000))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000))
        && (!('kecamatan' in data) || (data.kecamatan is string && data.kecamatan.size() <= 120))
        && (!('kabupaten' in data) || (data.kabupaten is string && data.kabupaten.size() <= 120))
        && (!('provinsi' in data) || (data.provinsi is string && data.provinsi.size() <= 120))
        && (!('negara' in data) || (data.negara is string && data.negara.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('foundedYear' in data) || (data.foundedYear is string && data.foundedYear.size() <= 10))
        && (!('statisticNumber' in data) || (data.statisticNumber is string && data.statisticNumber.size() <= 100))
        && (!('legalityInfo' in data) || (data.legalityInfo is string && data.legalityInfo.size() <= 2000))
        && (!('leaderName' in data) || (data.leaderName is string && data.leaderName.size() <= 150))
        && (!('history' in data) || (data.history is string && data.history.size() <= 10000))
        && (!('vision' in data) || (data.vision is string && data.vision.size() <= 3000))
        && (!('mission' in data) || (data.mission is string && data.mission.size() <= 5000))
        && (!('organizationStructure' in data) || (data.organizationStructure is string && data.organizationStructure.size() <= 5000))
        && (!('studentCount' in data) || (data.studentCount is number && data.studentCount >= 0 && data.studentCount <= 1000000))
        && (!('teacherCount' in data) || (data.teacherCount is number && data.teacherCount >= 0 && data.teacherCount <= 1000000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy is string && isValidId(data.updatedBy);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'phone', 'position',
          'role', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.uid is string && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 150
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('position' in data) || (data.position is string && data.position.size() <= 150))
        && data.role in ['Administrator', 'Pimpinan', 'Operator']
        && data.status in ['active', 'pending', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy is string && isValidId(data.updatedBy);
    }

    function isValidProposalCategory(data) {
      return data.keys().hasAll(['institutionId', 'name', 'isActive', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['institutionId', 'name', 'code', 'description', 'isActive', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.institutionId is string && isValidId(data.institutionId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 150
        && (!('code' in data) || (data.code is string && data.code.size() <= 30))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy is string && isValidId(data.updatedBy);
    }

    function isValidProposalTemplate(data) {
      return data.keys().hasAll(['institutionId', 'name', 'sections', 'isActive', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['institutionId', 'name', 'type', 'description', 'sections', 'isActive', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.institutionId is string && isValidId(data.institutionId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 150
        && (!('type' in data) || (data.type is string && data.type.size() <= 100))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && data.sections is list && data.sections.size() <= 50
        && (data.sections.size() == 0 || data.sections[0] is map)
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy is string && isValidId(data.updatedBy);
    }

    function isValidProposal(data) {
      return data.keys().hasAll(['institutionId', 'title', 'fiscalYear', 'status', 'totalBudget', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly([
          'institutionId', 'proposalNumber', 'proposalDate', 'fiscalYear', 'title',
          'categoryId', 'categoryName', 'proposalType', 'recipientName', 'recipientInstitution',
          'status', 'totalBudget', 'approvedAmount', 'receivedAmount', 'submittedAt', 'followUpNotes',
          'background', 'purpose', 'target', 'location', 'executionTime', 'activityDescription',
          'requirementPlan', 'closing', 'sectionsContent',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.institutionId is string && isValidId(data.institutionId)
        && (!('proposalNumber' in data) || (data.proposalNumber is string && data.proposalNumber.size() <= 100))
        && (!('proposalDate' in data) || (data.proposalDate is string && data.proposalDate.size() <= 30))
        && data.fiscalYear is number && data.fiscalYear >= 2000 && data.fiscalYear <= 2100
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 300
        && (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 128))
        && (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 150))
        && (!('proposalType' in data) || (data.proposalType is string && data.proposalType.size() <= 150))
        && (!('recipientName' in data) || (data.recipientName is string && data.recipientName.size() <= 200))
        && (!('recipientInstitution' in data) || (data.recipientInstitution is string && data.recipientInstitution.size() <= 200))
        && data.status in [
          'Draft', 'Menunggu persetujuan', 'Siap diajukan', 'Sudah diajukan',
          'Dalam proses', 'Disetujui', 'Ditolak', 'Bantuan diterima', 'Selesai'
        ]
        && data.totalBudget is number && data.totalBudget >= 0
        && (!('approvedAmount' in data) || (data.approvedAmount is number && data.approvedAmount >= 0))
        && (!('receivedAmount' in data) || (data.receivedAmount is number && data.receivedAmount >= 0))
        && (!('submittedAt' in data) || (data.submittedAt is string && data.submittedAt.size() <= 40))
        && (!('followUpNotes' in data) || (data.followUpNotes is string && data.followUpNotes.size() <= 3000))
        && (!('background' in data) || (data.background is string && data.background.size() <= 20000))
        && (!('purpose' in data) || (data.purpose is string && data.purpose.size() <= 10000))
        && (!('target' in data) || (data.target is string && data.target.size() <= 10000))
        && (!('location' in data) || (data.location is string && data.location.size() <= 1000))
        && (!('executionTime' in data) || (data.executionTime is string && data.executionTime.size() <= 500))
        && (!('activityDescription' in data) || (data.activityDescription is string && data.activityDescription.size() <= 20000))
        && (!('requirementPlan' in data) || (data.requirementPlan is string && data.requirementPlan.size() <= 20000))
        && (!('closing' in data) || (data.closing is string && data.closing.size() <= 10000))
        && (!('sectionsContent' in data) || (data.sectionsContent is list && data.sectionsContent.size() <= 50))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy is string && isValidId(data.updatedBy);
    }

    function isValidProposalBudget(data) {
      return data.keys().hasAll(['institutionId', 'proposalId', 'items', 'totalAmount', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['institutionId', 'proposalId', 'workGroup', 'items', 'totalAmount', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.institutionId is string && isValidId(data.institutionId)
        && data.proposalId is string && isValidId(data.proposalId)
        && (!('workGroup' in data) || (data.workGroup is string && data.workGroup.size() <= 150))
        && data.items is list && data.items.size() <= 200
        && (data.items.size() == 0 || data.items[0] is map)
        && data.totalAmount is number && data.totalAmount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy is string && isValidId(data.updatedBy);
    }

    function isValidProposalAttachment(data) {
      return data.keys().hasAll(['institutionId', 'proposalId', 'category', 'title', 'fileUrl', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['institutionId', 'proposalId', 'category', 'title', 'fileUrl', 'fileName', 'fileType', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.institutionId is string && isValidId(data.institutionId)
        && data.proposalId is string && isValidId(data.proposalId)
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.fileUrl is string && data.fileUrl.size() >= 1 && data.fileUrl.size() <= 2000
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255))
        && (!('fileType' in data) || (data.fileType is string && data.fileType.size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy is string && isValidId(data.updatedBy);
    }

    function isValidProposalArchive(data) {
      return data.keys().hasAll(['institutionId', 'proposalId', 'title', 'fiscalYear', 'status', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly([
          'institutionId', 'proposalId', 'proposalNumber', 'title', 'categoryName',
          'fiscalYear', 'proposalDate', 'recipientInstitution', 'totalBudget', 'status',
          'exportedFileUrl', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.institutionId is string && isValidId(data.institutionId)
        && data.proposalId is string && isValidId(data.proposalId)
        && (!('proposalNumber' in data) || (data.proposalNumber is string && data.proposalNumber.size() <= 100))
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 300
        && (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 150))
        && data.fiscalYear is number && data.fiscalYear >= 2000 && data.fiscalYear <= 2100
        && (!('proposalDate' in data) || (data.proposalDate is string && data.proposalDate.size() <= 30))
        && (!('recipientInstitution' in data) || (data.recipientInstitution is string && data.recipientInstitution.size() <= 200))
        && (!('totalBudget' in data) || (data.totalBudget is number && data.totalBudget >= 0))
        && data.status is string && data.status.size() >= 1 && data.status.size() <= 60
        && (!('exportedFileUrl' in data) || (data.exportedFileUrl is string && data.exportedFileUrl.size() <= 2000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy is string && isValidId(data.updatedBy);
    }

    function isValidProposalStatusHistory(data) {
      return data.keys().hasAll(['institutionId', 'proposalId', 'toStatus', 'createdAt', 'createdBy'])
        && data.keys().hasOnly(['institutionId', 'proposalId', 'fromStatus', 'toStatus', 'notes', 'createdAt', 'createdBy'])
        && data.institutionId is string && isValidId(data.institutionId)
        && data.proposalId is string && isValidId(data.proposalId)
        && (!('fromStatus' in data) || (data.fromStatus is string && data.fromStatus.size() <= 60))
        && data.toStatus is string && data.toStatus.size() >= 1 && data.toStatus.size() <= 60
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.createdAt is timestamp
        && data.createdBy is string && isValidId(data.createdBy);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['institutionId', 'action', 'entityType', 'entityId', 'actorUid', 'createdAt'])
        && data.keys().hasOnly(['institutionId', 'action', 'entityType', 'entityId', 'actorUid', 'actorName', 'details', 'createdAt'])
        && data.institutionId is string && isValidId(data.institutionId)
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 100
        && data.entityType is string && data.entityType.size() >= 2 && data.entityType.size() <= 80
        && data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128
        && data.actorUid is string && isValidId(data.actorUid)
        && (!('actorName' in data) || (data.actorName is string && data.actorName.size() <= 150))
        && (!('details' in data) || (data.details is string && data.details.size() <= 2000))
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // Connection test document (read-only ping)
    match /test/{docId} {
      allow get: if isSignedIn() && docId == 'connection';
    }

    // 1. Institutions
    match /institutions/{institutionId} {
      allow get: if isValidId(institutionId) && isAuthorizedStaff();
      allow list: if isAuthorizedStaff() && resource.data.name is string;
      allow create: if isEmailVerified() && isValidId(institutionId) && isValidInstitution(incoming())
        && isAdmin()
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified() && isValidId(institutionId) && isValidInstitution(incoming())
        && isAdmin()
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 2. Users (PII Protected, No Self-Admin Escalation)
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() && resource.data.role in ['Administrator', 'Pimpinan', 'Operator'];
      allow create: if isEmailVerified() && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          // Bootstrapped admin self-registration
          (isOwner(userId) && isBootstrappedAdmin() && incoming().role == 'Administrator' && incoming().status == 'active') ||
          // Standard new user registration: strictly Operator + pending (never auto-admin)
          (isOwner(userId) && incoming().role == 'Operator' && incoming().status == 'pending') ||
          // Existing admin creating a user profile
          isAdmin()
        );
      allow update: if isEmailVerified() && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Administrator manages roles, status, position, phone, displayName
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'position', 'role', 'status', 'updatedAt', 'updatedBy'])) ||
          // Tier 2: Owner updates only their own non-privileged profile fields
          (isOwner(userId) && isActiveUser()
            && incoming().role == existing().role
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'position', 'updatedAt', 'updatedBy']))
        );
      allow delete: if isValidId(userId) && isAdmin() && !isOwner(userId);
    }

    // 3. Proposal Categories
    match /proposalCategories/{categoryId} {
      allow get: if isValidId(categoryId) && isAuthorizedStaff();
      allow list: if isAuthorizedStaff() && resource.data.institutionId == 'ar-raudhah';
      allow create: if isEmailVerified() && isValidId(categoryId) && isValidProposalCategory(incoming())
        && (isAdmin() || isOperator())
        && institutionExists(incoming().institutionId)
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified() && isValidId(categoryId) && isValidProposalCategory(incoming())
        && (isAdmin() || isOperator())
        && incoming().institutionId == existing().institutionId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'description', 'isActive', 'updatedAt', 'updatedBy']);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // 4. Proposal Templates
    match /proposalTemplates/{templateId} {
      allow get: if isValidId(templateId) && isAuthorizedStaff();
      allow list: if isAuthorizedStaff() && resource.data.institutionId == 'ar-raudhah';
      allow create: if isEmailVerified() && isValidId(templateId) && isValidProposalTemplate(incoming())
        && (isAdmin() || isOperator())
        && institutionExists(incoming().institutionId)
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified() && isValidId(templateId) && isValidProposalTemplate(incoming())
        && (isAdmin() || isOperator())
        && incoming().institutionId == existing().institutionId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'description', 'sections', 'isActive', 'updatedAt', 'updatedBy']);
      allow delete: if isValidId(templateId) && isAdmin();
    }

    // 5. Proposals
    match /proposals/{proposalId} {
      allow get: if isValidId(proposalId) && isAuthorizedStaff();
      allow list: if isAuthorizedStaff() && resource.data.institutionId == 'ar-raudhah';
      allow create: if isEmailVerified() && isValidId(proposalId) && isValidProposal(incoming())
        && (isAdmin() || isOperator())
        && institutionExists(incoming().institutionId)
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified() && isValidId(proposalId) && isValidProposal(incoming())
        && incoming().institutionId == existing().institutionId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Admin override (including terminal state corrections)
          isAdmin() ||
          // Tier 2: Pimpinan approval & monitoring updates (when not terminal)
          (isPimpinan() && existing().status != 'Selesai'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedAmount', 'receivedAmount', 'submittedAt', 'followUpNotes', 'updatedAt', 'updatedBy'])) ||
          // Tier 3: Operator content & draft updates (when not terminal)
          (isOperator() && existing().status != 'Selesai'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'proposalNumber', 'proposalDate', 'fiscalYear', 'title', 'categoryId', 'categoryName',
              'proposalType', 'recipientName', 'recipientInstitution', 'status', 'totalBudget',
              'submittedAt', 'followUpNotes', 'background', 'purpose', 'target', 'location',
              'executionTime', 'activityDescription', 'requirementPlan', 'closing', 'sectionsContent',
              'updatedAt', 'updatedBy'
            ]))
        );
      allow delete: if isValidId(proposalId) && isAdmin();
    }

    // 6. Proposal Budgets (RAB)
    match /proposalBudgets/{budgetId} {
      allow get: if isValidId(budgetId) && isAuthorizedStaff();
      allow list: if isAuthorizedStaff() && resource.data.institutionId == 'ar-raudhah';
      allow create: if isEmailVerified() && isValidId(budgetId) && isValidProposalBudget(incoming())
        && (isAdmin() || isOperator())
        && institutionExists(incoming().institutionId)
        && proposalExists(incoming().proposalId)
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified() && isValidId(budgetId) && isValidProposalBudget(incoming())
        && (isAdmin() || isOperator())
        && incoming().institutionId == existing().institutionId
        && incoming().proposalId == existing().proposalId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['workGroup', 'items', 'totalAmount', 'updatedAt', 'updatedBy']);
      allow delete: if isValidId(budgetId) && (isAdmin() || isOperator());
    }

    // 7. Proposal Attachments
    match /proposalAttachments/{attachmentId} {
      allow get: if isValidId(attachmentId) && isAuthorizedStaff();
      allow list: if isAuthorizedStaff() && resource.data.institutionId == 'ar-raudhah';
      allow create: if isEmailVerified() && isValidId(attachmentId) && isValidProposalAttachment(incoming())
        && (isAdmin() || isOperator())
        && institutionExists(incoming().institutionId)
        && proposalExists(incoming().proposalId)
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified() && isValidId(attachmentId) && isValidProposalAttachment(incoming())
        && (isAdmin() || isOperator())
        && incoming().institutionId == existing().institutionId
        && incoming().proposalId == existing().proposalId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'title', 'fileUrl', 'fileName', 'fileType', 'updatedAt', 'updatedBy']);
      allow delete: if isValidId(attachmentId) && (isAdmin() || isOperator());
    }

    // 8. Proposal Archives
    match /proposalArchives/{archiveId} {
      allow get: if isValidId(archiveId) && isAuthorizedStaff();
      allow list: if isAuthorizedStaff() && resource.data.institutionId == 'ar-raudhah';
      allow create: if isEmailVerified() && isValidId(archiveId) && isValidProposalArchive(incoming())
        && (isAdmin() || isOperator())
        && institutionExists(incoming().institutionId)
        && proposalExists(incoming().proposalId)
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified() && isValidId(archiveId) && isValidProposalArchive(incoming())
        && (isAdmin() || isOperator())
        && incoming().institutionId == existing().institutionId
        && incoming().proposalId == existing().proposalId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'proposalNumber', 'title', 'categoryName', 'fiscalYear', 'proposalDate',
          'recipientInstitution', 'totalBudget', 'status', 'exportedFileUrl', 'updatedAt', 'updatedBy'
        ]);
      allow delete: if isValidId(archiveId) && isAdmin();
    }

    // 9. Proposal Status History (Append-Only)
    match /proposalStatusHistory/{historyId} {
      allow get: if isValidId(historyId) && isAuthorizedStaff();
      allow list: if isAuthorizedStaff() && resource.data.institutionId == 'ar-raudhah';
      allow create: if isEmailVerified() && isValidId(historyId) && isValidProposalStatusHistory(incoming())
        && isAuthorizedStaff()
        && institutionExists(incoming().institutionId)
        && proposalExists(incoming().proposalId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 10. Audit Logs (Append-Only, Admin Read Only)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin() && resource.data.institutionId == 'ar-raudhah';
      allow create: if isEmailVerified() && isValidId(logId) && isValidAuditLog(incoming())
        && (isAuthorizedStaff() || (isBootstrappedAdmin() && incoming().actorUid == request.auth.uid))
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
